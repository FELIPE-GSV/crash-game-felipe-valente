# Keycloak (exposto ao browser via import.meta.env)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=crash-game
VITE_KEYCLOAK_CLIENT_ID=crash-game-frontend

# Proxy targets do Vite (server-side, não expostos ao browser)
# Em Docker são sobrescritos pelo docker-compose.yml
API_TARGET=http://localhost:8000
WS_TARGET=ws://localhost:4001
